{% extends 'base.html.twig' %}

{% block title %}Mesaje — Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mesaje de contact</h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-dark">&larr; Dashboard</a>
    </div>

    {% if contactRequests is empty %}
        <p class="text-muted">Niciun mesaj primit încă.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Nume</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>Mesaj</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contactRequest in contactRequests %}
                        <tr>
                            <td class="text-nowrap">{{ contactRequest.createdAt|date('d.m.Y H:i') }}</td>
                            <td>{{ contactRequest.name }}</td>
                            <td><a href="mailto:{{ contactRequest.email }}">{{ contactRequest.email }}</a></td>
                            <td>
                                {% if contactRequest.phone %}
                                    <a href="tel:{{ contactRequest.phone }}">{{ contactRequest.phone }}</a>
                                {% else %}
                                    &mdash;
                                {% endif %}
                            </td>
                            <td class="message-cell">{{ contactRequest.message }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
