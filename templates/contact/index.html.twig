{% extends 'layout/public.html.twig' %}

{% block title %}Contact — Cîrceag Ionuț{% endblock %}

{% block content %}
    <div class="section-space page-offset">
        <div class="container">
            <div class="row gy-5">
                <div class="col-lg-6">
                    <span class="eyebrow-badge mb-3"><span class="dot"></span><span>Hai să vorbim</span></span>
                    <h1 class="font-display display-4 mt-3 mb-4">Contact</h1>
                    <p class="mb-5 measure text-body-secondary">
                        Spune-mi câteva cuvinte despre ședința pe care o ai în minte și revin cu un răspuns
                        cât mai curând.
                    </p>

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success" role="alert">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger" role="alert">{{ message }}</div>
                    {% endfor %}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        <div class="mb-4">
                            {{ form_label(form.name) }}
                            {{ form_widget(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.phone) }}
                            {{ form_widget(form.phone) }}
                            {{ form_errors(form.phone) }}
                        </div>
                        <div class="mb-4">
                            {{ form_label(form.message) }}
                            {{ form_widget(form.message) }}
                            {{ form_errors(form.message) }}
                        </div>
                        <div class="visually-hidden" aria-hidden="true">
                            {{ form_label(form.website) }}
                            {{ form_widget(form.website) }}
                        </div>
                        <button type="submit" class="btn btn-ink">Trimite mesajul</button>
                    {{ form_end(form) }}
                </div>

                <div class="col-lg-5 offset-lg-1">
                    <div class="info-panel">
                        <span class="eyebrow-badge mb-3"><span class="dot"></span><span>Alternativă</span></span>
                        <p class="mt-3 mb-3 text-body-secondary">
                            Preferi să scrii direct, fără formular? Îmi poți trimite un email oricând la:
                        </p>
                        <a href="mailto:{{ contact_email }}" class="font-display fs-3 d-inline-block link-contact">
                            {{ contact_email }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
