{% extends 'layout/public.html.twig' %}

{% block title %}{{ album.title }} — Cîrceag Ionuț{% endblock %}

{% block content %}
    <div class="section-space page-offset">
        <div class="container">
            <a href="{{ path('app_gallery') }}" class="link-contact-secondary d-inline-flex align-items-center gap-1 mb-4">
                <span class="material-symbols-outlined icon-sm">arrow_back</span>
                Toate albumele
            </a>

            <h1 class="font-display display-4 mb-2">{{ album.title }}</h1>
            <span class="album-card-meta mb-5 d-block">{{ photos|length }} poze &middot; {{ album.createdAt|date('Y') }}</span>
            {% if album.description %}
                <p class="mb-5 measure-lg text-body-secondary">{{ album.description }}</p>
            {% endif %}

            {% if photos is empty %}
                <p class="text-body-secondary">Pozele acestui album vor fi publicate în curând.</p>
            {% else %}
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                    {% for photo in photos %}
                        <div class="col">
                            <div class="album-card-cover rounded-1">
                                <img src="{{ asset(photo.path) }}" alt="{{ photo.title ?? album.title }}" loading="lazy">
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
